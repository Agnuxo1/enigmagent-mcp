{
  "name": "enigmagent-mcp",
  "version": "2.0.0",
  "mcpName": "io.github.Agnuxo1/enigmagent-mcp",
  "private": false,
  "files": [
    "index.js",
    "vault-secure.js",
    "mcp-server.js",
    "rest-server.js",
    "integrations.js",
    "README.md",
    "LICENSE",
    "manifest.json",
    "server.json",
    "smithery.yaml"
  ],
  "description": "Local encrypted vault MCP server with Argon2id, AES-256-GCM, authenticated REST, bounded MCP transport, and opt-in raw resolution.",
  "type": "module",
  "bin": {
    "enigmagent-mcp": "./index.js"
  },
  "scripts": {
    "start": "node index.js",
    "start:rest": "node index.js --mode rest --port 3737",
    "start:mcp": "node index.js --mode mcp",
    "test": "node --test",
    "benchmark": "node scripts/benchmark.js",
    "check": "node --check index.js && node --check vault-secure.js && node --check mcp-server.js && node --check rest-server.js && node --check integrations.js"
  },
  "dependencies": {
    "@noble/hashes": "1.4.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "llm",
    "claude-desktop",
    "cursor",
    "vault",
    "secrets",
    "secrets-management",
    "credentials",
    "encryption",
    "aes-256-gcm",
    "argon2id",
    "security",
    "enigmagent",
    "openclaw",
    "p2pclaw"
  ],
  "author": "Francisco Angulo de Lafuente <agnuxo1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/Agnuxo1/EnigmAgent#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Agnuxo1/enigmagent-mcp"
  },
  "bugs": {
    "url": "https://github.com/Agnuxo1/enigmagent-mcp/issues"
  }
}
